# Configure as secrets in your backend host. Never commit the real .env.
REPLICATE_API_TOKEN=replace_with_your_replicate_token
ALLOWED_ORIGINS=https://inecloud313-prog.github.io

# Protects spend/write endpoints. Use a long random value; paste the same one in the Releases page.
ADMIN_TOKEN=replace_with_a_long_random_string
BOT_ENABLED=1

# Music model (Replicate). Default: stability-ai/stable-audio-2.5 (official; up to 190 s per run, so a 180-190 s
# track is ONE generation). Licence: Stability AI Community License = commercial use allowed IF you register with
# Stability AI and your total annual revenue (with affiliates) is under US$1M; otherwise Enterprise licence.
# Releases stay blocked until you verify those terms and set MODEL_LICENSE_COMMERCIAL=1.
# (meta/musicgen is CC-BY-NC 4.0, non-commercial: do not use it for releases.)
MUSIC_MODEL=stability-ai/stable-audio-2.5
MODEL_LICENSE_COMMERCIAL=0
# Optional overrides; presets for the two models above are built in.
# SEGMENT_SECONDS=190
# MODEL_DURATION_KEY=duration
# MODEL_EXTRA_INPUT={"steps": 8, "cfg_scale": 1}

# Compose/Docker set these already; override only if you mount storage elsewhere.
# DB_PATH=/app/data/zi.db
# WORK_DIR=/app/data/work
